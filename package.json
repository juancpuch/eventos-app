{
  "name": "eventos-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier . --write",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down -v"
  }
}
